# Copy this file to `.env` and fill in what you need. `.env` is gitignored, and
# CI fails the build if it ever becomes tracked.

# Required only for the Google Scholar source. OpenAlex, the default, needs no key.
# Get one at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_api_key_here

# The Google Scholar source is hidden from the web interface unless this is set.
# Scholar is the only paid source and the web app has no authentication or rate
# limiting, so a hosted copy carrying a key would let every visitor spend your
# quota. Set this only on a machine you control. The CLI and library ignore it:
# whoever runs those already owns the key.
# SCHOLAR_ENABLED=1

# Optional. Identifies you to OpenAlex's "polite pool" for higher rate limits.
# This is a contact address, not a credential.
# OPENALEX_MAILTO=you@university.edu
